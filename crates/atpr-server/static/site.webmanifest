{
  "name": "atpr.to",
  "short_name": "atpr.to",
  "description": "Short links stored as records in your own AT Protocol repository.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f0eee8",
  "theme_color": "#f0eee8",
  "icons": [
    {
      "src": "/static/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/static/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
